generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // `url` es la **pooled**: la usa la aplicacion. Neon y cualquier proveedor
  // con pooler cortan conexiones o limitan cuantas se pueden abrir, y Prisma
  // con su propio pool encima las agota.
  url = env("DATABASE_URL")

  // `directUrl` es la **sin pooler**, y solo la usa `prisma migrate deploy`.
  //
  // No es una diferencia de rendimiento: es que el pooler de Neon es PgBouncer
  // en modo *transaction*, que devuelve la conexion real al pool al terminar
  // cada transaccion. `migrate deploy` toma un **advisory lock de sesion** con
  // `pg_advisory_lock`, asi que:
  //
  //   1. el lock se toma en una conexion backend del PgBouncer
  //   2. la transaccion termina, PgBouncer devuelve esa conexion al pool
  //   3. el lock **se queda puesto** en esa conexion, que queda `idle`
  //   4. el siguiente `migrate deploy` no lo puede tomar y revienta:
  //
  //      Timed out trying to acquire a postgres advisory lock
  //      (SELECT pg_advisory_lock(72707369)). Elapsed: 10000ms.
  //
  // Como el deploy corre `migrate deploy` en el arranque, el segundo deploy ya
  // moria. Y el error era invisible en el panel: Render solo decia
  // "Exited with status 1" sin el motivo.
  directUrl = env("DIRECT_URL")
}

enum WineCategory {
  Tinto
  Blanco
  Rosado
  Espumante
}

enum OrderStatus {
  pendiente
  preparando
  enviado
  entregado
  cancelado
  devuelto
}

/// Estado **del pago**, separado de `OrderStatus` (D-7 de la spec 009).
///
/// `OrderStatus` dice en que anda el paquete, y lo cambia **a mano** un
/// vendedor. El pago es otro hecho: no lo cambia nadie, lo cambia la webhook de
/// Mercado Pago. Con un solo campo, un pedido en `cancelado` no diria si la
/// plata entro, y el selector del panel mezclaria dos preguntas distintas.
///
/// Los dos enums comparten el valor `pendiente` y significan cosas distintas:
/// `status = pendiente` es "lo estamos armando" y `pagoEstado = pendiente` es
/// "abrio Mercado Pago y no termino". Prisma los tipa como enums separados, asi
/// que TypeScript rechaza cruzarlos; lo que **no** distingue es leerlos en una
/// vista. Por eso los comentarios de cada campo repiten a que se refieren.
enum EstadoPago {
  /// El comprador lleno el formulario. Todavía no abrió Mercado Pago.
  no_iniciado
  /// Abrió Mercado Pago y no terminó.
  pendiente
  /// Mercado Pago confirmó el pago.
  aprobado
  /// Mercado Pago rechazó el pago.
  rechazado
  /// No se completó en 10 minutos.
  expirado
}

enum UserRole {
  admin
  gestor
  vendedor
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         UserRole       @default(vendedor)
  refreshTokens RefreshToken[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Wine {
  id           String       @id @default(cuid())
  name         String
  winery       String
  varietal     String
  category     WineCategory
  vintage      Int
  /// Pesos argentinos enteros. NO centavos (D-15).
  price        Int
  description  String?
  tastingNotes String?
  foodPairing  String?
  imageUrl     String
  stock        Int          @default(0)
  activo       Boolean      @default(true)
  orderItems   OrderItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([category])
  @@index([varietal])
  @@index([activo])
  @@index([name])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  /// Opcional: CE-04 de 004-a permite clientes sin email.
  /// Postgres permite multiples NULL en una columna UNIQUE.
  email       String?  @unique
  phone       String?
  totalOrders Int      @default(0)
  totalSpent  Int      @default(0)
  lastOrderAt DateTime?
  tags        String[] @default([])
  notes       Note[]
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Note {
  id         String   @id @default(cuid())
  text       String
  /// "Admin" hardcoded: no hay auth real todavia (D-05 de 004-a).
  author     String   @default("Admin")
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Order {
  id              String          @id @default(cuid())
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  total           Int
  /// Estado **del envío**: `pendiente`, `preparando`, `enviado`, `entregado`…
  /// Lo cambia una persona desde el panel. No tiene nada que ver con el pago.
  status          OrderStatus     @default(pendiente)
  /// Estado **del pago** (spec 009, D-7). Lo cambia la webhook, nunca una
  /// persona. Arranca en `no_iniciado` porque el pedido se crea antes de que
  /// el comprador abra Mercado Pago.
  pagoEstado      EstadoPago      @default(no_iniciado)
  /// Id del pago en Mercado Pago. Nulo hasta que hay Preference.
  ///
  /// Es la llave con la que la webhook encuentra el pedido: **no** se busca por
  /// email ni por nombre, porque dos compradores pueden comprar el mismo día y
  /// el mismo vino.
  pagoId          String?         @unique
  shippingAddress Json
  timeline        OrderTimeline[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  /// El cron de expiracion (T5) consulta por `pagoEstado` + `createdAt` juntos,
  /// asi que el indice va en los dos y no en uno solo.
  @@index([pagoEstado, createdAt])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  wineId   String
  wine     Wine   @relation(fields: [wineId], references: [id])
  quantity Int
  /// Precio unitario en el momento de la compra (pesos).
  price    Int

  @@index([orderId])
  @@index([wineId])
}

/// Un evento del pedido: **del envio o del pago**, no de los dos.
///
/// La entrada tiene `status` o tiene `pagoEstado`, nunca las dos. Una entrada de
/// envio dice "el vendedor entrego esto"; una de pago dice "Mercado Pago
/// aprobo esto". Mezclarlas en un campo de texto seria volver a la columna que
/// significa dos cosas, que es justo lo que la spec 009 vino a separar.
///
/// `status` paso a **opcional** por esto. Antes era obligatorio y la unica forma
/// de registrar un evento de pago era meter un estado de envio falso, que
/// mentia dos veces: en el historial y en el `Order.status`.
///
/// Volverlo opcional obligo a cambiar, **en el mismo commit**: el schema JSON de
/// la respuesta de `GET /api/orders/:id` —que declara `status: { type: 'string' }`
/// y **cortaria** un `null` (gotcha 11 de `AGENTS.md`)— y el componente
/// `order_timeline.tsx` del panel, que pasa `entrada.status` a `StatusBadge`.
model OrderTimeline {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Estado **del envio**. Nulo en las entradas de pago.
  status      OrderStatus?
  /// Estado **del pago**. Nulo en las entradas de envio.
  pagoEstado  EstadoPago?
  /// "Mercado Pago" en las de pago, "Admin" en las de envio. Se deja explicito
  /// porque una entrada sin autor parece escrita a mano cuando la escribio una
  /// webhook.
  origen      String       @default("Admin")
  note        String?
  author      String       @default("Admin")
  createdAt   DateTime     @default(now())

  @@index([orderId])
  @@index([pagoEstado])
}